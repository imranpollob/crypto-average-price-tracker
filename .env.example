# Local SQLite database file (relative to the project root).
DATABASE_URL="file:./data/portfolio.db"

# Optional: key for encrypting stored API credentials (base64 of 32 random bytes).
# If unset, ./data/master.key is created on first use.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# APP_ENCRYPTION_KEY=
